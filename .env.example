# Copy to .env (or set in your host's dashboard). Never commit real values.

# Server
PORT=8080
# 127.0.0.1 in development; 0.0.0.0 when NODE_ENV=production
HOST=
NODE_ENV=production
# Folder to serve: '.' for the source tree, 'dist' after `npm run build`
STATIC_ROOT=dist
# Set to 1 only behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=0

# Analytics (first-party, cookie-free)
# Owner dashboard token: at least 24 random characters, e.g. `openssl rand -hex 24`
ANALYTICS_ADMIN_TOKEN=
# Where event files are written (one file per day, per environment)
ANALYTICS_DATA_DIR=data
# Days of events to keep before automatic deletion
ANALYTICS_RETENTION_DAYS=395
# 0 accepts and discards events (collection paused)
ANALYTICS_COLLECT=1
